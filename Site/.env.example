# Discord OAuth configuration
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# Firebase Realtime Database
FIREBASE_DATABASE_URL=https://YOUR_FIREBASE_PROJECT.firebaseio.com

# Firebase service account JSON path (relative to Site/ or absolute)
SERVICE_ACCOUNT_PATH=../serviceAccountKey.json

# Optional site base URL
SITE_URL=http://localhost:3000

# Session secret for Discord login
SESSION_SECRET=change-me-to-a-strong-secret
